# Template do .env consumido pelo docker-compose.yml.
# Copie para .env na VM e preencha. NUNCA comite o .env preenchido.
#
#   cp .env.production.example .env
#
# Para gerar segredos:
#   openssl rand -hex 32

# ─── Banco ──────────────────────────────────────────────────────────────────
POSTGRES_DB=ufly_financeiro
POSTGRES_USER=ufly_user
# Obrigatório — o compose se recusa a subir sem isso.
POSTGRES_PASSWORD=

# ─── Endereço público / TLS ─────────────────────────────────────────────────
# Define como o Caddy emite o certificado:
#   um domínio (financeiro.exemplo.com.br) -> Let's Encrypt, certificado válido
#   um IP (203.0.113.10)                   -> CA interna, o navegador avisa
#
# HTTPS é obrigatório: o MSAL precisa da Web Crypto API, que só existe em
# contexto seguro. Em HTTP puro o frontend não inicializa.
SITE_ADDRESS=

# Endereço HTTP puro atendido em PARALELO ao domínio, só durante a transição
# (ex.: http://203.0.113.10). Serve para não perder o acesso enquanto a porta
# 443 não estiver liberada no firewall da nuvem.
# Deixar vazio cai em http://localhost, que atende apenas dentro do container —
# na prática desliga o acesso externo por IP.
LEGACY_HTTP_ADDRESS=

# Restrição de acesso por IP (lista separada por espaço, IPs ou CIDRs).
# Vazio = aplicação aberta para qualquer origem.
# Com o login pelo Entra ID valendo, esta lista deixa de ser a barreira de
# segurança e passa a ser opcional — útil apenas para limitar a exposição.
# Descubra o IP de quem vai acessar em https://ifconfig.me
ALLOWED_IPS=

# ─── Backend ────────────────────────────────────────────────────────────────
# Obrigatório. Trocar este valor invalida todos os tokens emitidos.
JWT_SECRET=
JWT_EXPIRY=24h

# Origem pública da aplicação. Com o nginx servindo /api na mesma origem o CORS
# nem entra em jogo, mas mantenha coerente com a URL real de acesso.
CORS_ORIGIN=http://SEU_IP_PUBLICO

# ─── Entra ID / MSAL (deixe vazio para não habilitar) ───────────────────────
# IDs da App Registration no Entra ID. O login é SPA (o client id vai no bundle
# do navegador); o client secret só é usado pelo backend para enviar os alertas
# de orçamento pelo Microsoft Graph — sem ele, os e-mails ficam desligados.
MSAL_CLIENT_ID=
MSAL_TENANT_ID=
MSAL_CLIENT_SECRET=
# URL pública, usada nos links dos e-mails
APP_URL=

# Criar usuário no primeiro login mesmo SEM grupo de acesso no Entra.
#
# Deixe false. Com os grupos configurados, o próprio grupo é a lista de acesso:
# quem está em um dos grupos mapeados em entra_group_mapping entra e é criado
# automaticamente, com o papel do grupo. Este flag só existe como escape para
# ambiente onde os grupos ainda não existem — ligá-lo em produção daria a
# QUALQUER pessoa do tenant acesso ao financeiro completo, porque os dados são
# compartilhados entre todos os usuários.
ENTRA_AUTO_PROVISION=false

# ─── Frontend (injetado no config.js no startup do container) ───────────────
VITE_APP_NAME=Ufly Controle Financeiro
VITE_MSAL_CLIENT_ID=
VITE_MSAL_AUTHORITY=https://login.microsoftonline.com/<tenant-id>
# Precisa casar EXATAMENTE com uma das Redirect URIs cadastradas na App
# Registration (plataforma SPA), senão o login morre com AADSTS50011.
# Ex.: https://financeiro.exemplo.com.br
VITE_MSAL_REDIRECT_URI=

