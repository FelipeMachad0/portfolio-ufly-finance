# Copie para backend/.env.development (lido por `npm run dev`).
# Para rodar sem configurar nada, use `npm run demo` na raiz: sobe um Postgres
# embutido e o modo demonstração, dispensando este arquivo.

NODE_ENV=development
PORT=3000

# Banco (PostgreSQL)
DATABASE_URL=postgresql://usuario:senha@localhost:5432/ufly_financeiro

# JWT da aplicação — gere com: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRY=24h

# Origem do frontend
CORS_ORIGIN=http://localhost:5173
# URL pública do app, usada nos links dos e-mails de alerta de orçamento
APP_URL=http://localhost:5173

# Microsoft Entra ID — login (tenant + client id) e envio dos alertas de
# orçamento pelo Microsoft Graph (client secret). Vazio = login pelo Entra desligado.
MSAL_TENANT_ID=
MSAL_CLIENT_ID=
MSAL_CLIENT_SECRET=
# Criar usuário no primeiro login mesmo sem grupo mapeado (ver entra_group_mapping)
ENTRA_AUTO_PROVISION=false

# Modo demonstração: habilita POST /api/auth/demo e os dados fictícios
DEMO_MODE=false

# Onde os anexos são gravados (padrão: backend/uploads)
STORAGE_DIR=
# Tempo (ms) até uma leitura de documento interrompida voltar para a fila
LEITURA_PRAZO_MS=
