# Copie para frontend/.env.development (lido por `npm run dev`).
VITE_API_URL=http://localhost:3000/api
VITE_APP_NAME=Ufly Controle Financeiro

# Microsoft Entra ID / MSAL (deixe vazio para não habilitar)
VITE_MSAL_CLIENT_ID=
VITE_MSAL_AUTHORITY=https://login.microsoftonline.com/<tenant-id>
VITE_MSAL_REDIRECT_URI=

# Mostra o botão "Entrar como demonstração" (backend com DEMO_MODE=true)
VITE_DEMO_MODE=false
